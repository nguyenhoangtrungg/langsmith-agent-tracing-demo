# Offline không cần tạo file .env.
# Sao chép file này thành .env cạnh trace_demo.py để dùng live.
MODEL_PROVIDER=auto
GOOGLE_API_KEY=
GOOGLE_MODEL=
OPENROUTER_API_KEY=
